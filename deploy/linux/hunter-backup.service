[Unit]
Description=Verified Hunter workspace backup
[Service]
Type=oneshot
User=hunter
Group=hunter
WorkingDirectory=/opt/hunter
EnvironmentFile=/etc/hunter.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/hunter/.venv/bin/python scripts/server_admin.py backup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hunter
